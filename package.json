{
  "name": "cafe-pos",
  "version": "1.0.2",
  "description": "نظام إدارة المقهى - نقطة بيع ولوحة تحكم",
  "main": "main.js",
  "author": "Cafe POS",
  "scripts": {
    "build": "esbuild app.js --bundle --outfile=dist/bundle.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "publish": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.2.1",
    "firebase": "^10.12.0",
    "nodemailer": "^6.9.14",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.1"
  },
  "build": {
    "appId": "com.cafepos.app",
    "productName": "نظام إدارة المقهى",
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "index.html",
      "styles.css",
      "dist/bundle.js",
      "email-config.js",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "aljalyaltahr21-dot",
      "repo": "CAFEE"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
